{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "event.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {"properties": {
      "type": {"const": "event"},
      "payload": {"type": "object", "additionalProperties": false,
        "required": ["event_kind", "targets", "reason"],
        "properties": {
          "event_kind": {"enum": ["upstream-resolution", "supersession", "correction", "withdrawal", "dispute"]},
          "targets": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/typed_ref"}},
          "reason": {"$ref": "common.schema.json#/$defs/text"}, "supporting_reports": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/uuid"}},
          "supporting_links": {"type": "array", "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 1000}},
          "relation": {"type": "object", "additionalProperties": false, "required": ["kind", "from", "to"], "properties": {"kind": {"enum": ["supersedes", "corrects", "withdraws", "disputes"]}, "from": {"$ref": "#/$defs/typed_ref"}, "to": {"$ref": "#/$defs/typed_ref"}}},
          "resolution": {"type": "object", "additionalProperties": false, "required": ["relevance", "upstream_url", "fixed_in"], "properties": {"relevance": {"const": "claimed"}, "upstream_url": {"type": "string", "format": "uri", "maxLength": 1000}, "fixed_in": {"$ref": "common.schema.json#/$defs/fixed_in"}, "migration_required": {"type": "boolean"}, "restart_required": {"enum": ["none", "relogin", "reboot", "unknown"]}}}
        },
        "allOf": [
          {"if": {"properties": {"event_kind": {"const": "upstream-resolution"}}}, "then": {"required": ["resolution"], "not": {"required": ["relation"]}}, "else": {"not": {"required": ["resolution"]}}},
          {"if": {"properties": {"event_kind": {"enum": ["supersession", "correction", "withdrawal", "dispute"]}}}, "then": {"required": ["relation"]}}
        ]
      }
    }}
  ],
  "$defs": {
    "typed_ref": {"type": "object", "additionalProperties": false, "required": ["id", "type"], "properties": {"id": {"$ref": "common.schema.json#/$defs/uuid"}, "type": {"enum": ["case", "change", "report", "event"]}}}
  }
}
