{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "case.schema.json",
  "allOf": [
    {"$ref": "common.schema.json#/$defs/envelope"},
    {"properties": {
      "type": {"const": "case"},
      "payload": {"type": "object", "additionalProperties": false,
        "required": ["title", "intent", "domains", "expectation", "observed"],
        "properties": {
          "title": {"$ref": "common.schema.json#/$defs/short_text"}, "intent": {"enum": ["corrective", "optional", "undetermined"]},
          "domains": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"}},
          "observed": {"$ref": "common.schema.json#/$defs/text"}, "introduced_by": {"type": "string", "maxLength": 4000},
          "expectation": {"type": "object", "additionalProperties": false, "required": ["basis", "text"], "properties": {"basis": {"enum": ["documented", "previously-working", "compatibility", "user-requested", "unknown"]}, "text": {"$ref": "common.schema.json#/$defs/text"}}}
        }}
    }}
  ]
}
