+                    lambda api: _build_publication(
+                        api, policy, published, root / f"site-{index}"),
+                )
+                data, proof, status = built
+                if index == 1:
+                    if published["status"]["status"] != "idle":
+                        raise RuntimeError("First fair-intake run was not exhausted")
